APP_URL=https://billing.example.com
ROUTER_ID=
ROUTER_CONNECTOR_TOKEN=
# Use the router's private VPN DNS name/address when the connector runs off-site.
# The HTTPS certificate must be valid for this host and trusted by Node.js.
ROUTER_REST_URL=https://router-vpn.example.net/rest
ROUTER_USERNAME=
ROUTER_PASSWORD=
# For a private certificate authority, store its PEM file at
# /etc/router-connector/router-ca.pem on the VPS and uncomment this setting.
# NODE_EXTRA_CA_CERTS=/etc/router-connector/router-ca.pem
