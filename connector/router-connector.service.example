[Unit]
Description=RouterOS billing connector
Wants=network-online.target wg-quick@wg0.service
After=network-online.target wg-quick@wg0.service

[Service]
Type=simple
User=router-connector
Group=router-connector
WorkingDirectory=/opt/router-connector
ExecStart=/usr/bin/node --env-file=/etc/router-connector.env /opt/router-connector/connector/agent.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
