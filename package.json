{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "app:android:sync": "cap sync android",
    "app:android:apk": "npm run app:android:sync && cd android && gradlew.bat assembleDebug",
    "app:windows": "electron-builder --win nsis --x64",
    "db:check": "node --env-file=.env.local scripts/check-database.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "google-auth-library": "^11.1.0",
    "lucide-react": "^1.16.0",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "life.lktech.billing",
    "productName": "LKTECH",
    "directories": {
      "app": "desktop",
      "output": "release/windows"
    },
    "files": [
      "**/*"
    ],
    "win": {
      "icon": "public/favicon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
